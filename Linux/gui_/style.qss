* {
    font-family: "DejaVu Sans Mono";
    font-size: 16px;
    color: #3f12c7;
}

QMainWindow {
    background-color: #150130;
}

QWidget#centralwidget {
    background-color: #150130;
    border: none;
}

QFrame#header {
    background-color: #150130;
    border: 3px solid #2d1180;
}

QLabel#titleLabel {
    border: 3px solid #2d1180;
    padding: 4px;
}

QToolButton#gearButton,
QPushButton#closeButton {
    border: 3px solid #2d1180;
    border-radius: 0px;
    background: #000000;
}

QFrame#serverPanel {
    border: 3px solid #2d1180;
    background-color: #0b0117;
}

QLabel#selected_server_label {
    border: 3px solid #2d1180;
    border-radius: 15px;
    padding: 3px;
    background: #080118;
}

QListWidget#server_list {
    border: 3px solid #2d1180;
    background-color: #000000;
}

QListWidget#server_list::item {
    min-height: 27px;
    border-bottom: 3px solid #2d1180;
}

QListWidget#server_list::item:selected {
    background-color: #1b0a29;
}

QFrame#toggleFrame {
    border: 3px solid #1e17ae;
    border-radius: 20px;
    background: #0f000e;
}

QPushButton#onButton,
QPushButton#offButton {
    border: none;
    background-color: #000000;
    min-height: 64px;
}

QPushButton#onButton {
    border-right: 3px solid #2d1180;
    background-color: #000000;
}



/* SETTINGS */
QWidget#SettingsForm {
    background-color: #0d011d;
}

QFrame#infoPanel {
    background-color: #0d011d;
    border: 3px solid #8b1111;
}

QLabel#infoLabel {
    color: #8b1111;
    font-size: 28px;
    border: 3px solid #8b1111;
}


QWidget#SettingsForm {
    background-color: #0d011d;
    border: 3px solid #8b1111;
}

QTreeWidget#settingsList {
    padding: 0px;
    background-color: #0d011d;
    color: #8b1111;
    border: 3px solid #8b1111;
}

QTreeWidget#settingsList::item {
    margin: 0px;
    padding: 6px 8px;
    border-bottom: 3px solid #8b1111;
}



/* SubLink-QWidget-button */
QWidget#GetSubWindow {
    background-color: #0d011d;
    border: 2px solid #8b1111;
}

QFrame#frame {
    background-color: #0d011d;
    border: 2px solid #8b1111;
}

QLineEdit#input_SubLink {
    background-color: #160b25;
    color: #f0dbe0;
    border: 2px solid #8b1111;
    padding: 4px 8px;
    selection-background-color: #522044;
}

QPushButton#button_get_sub {
    background-color: #180d28;
    color: #e7cdd3;
    border: 2px solid #8b1111;
    padding: 4px;
}

QPushButton#button_get_sub:hover {
    background-color: #2b1638;
    border-color: #20a050;
}

QPushButton#button_get_sub:pressed {
    background-color: #20a050;
    color: #0d011d;
}