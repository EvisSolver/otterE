QWidget#centralwidget {
    background-color: #0d011d;
}

QFrame#header,
QFrame#serverPanel,
QFrame#toggleFrame {
    background-color: #16052b;
    border: 3px solid #7027a8;
    border-radius: 10px;
}

QLabel#selected_server_label,
QLabel#titleLabel {
    background-color: #21083d;
    border: 2px solid #9b4dcc;
    border-radius: 7px;
    color: #ffffff;
    font-weight: bold;
}

QListWidget#server_list {
    background-color: #120321;
    border: 3px solid #7027a8;
    border-radius: 7px;
    color: #ffffff;
}

QListWidget#server_list::item {
    padding: 7px;
    border-bottom: 2px solid #2e0054;
}

QListWidget#server_list::item:selected {
    background-color: #7027a8;
    color: white;
}

QToolButton#gearButton {
    qproperty-icon: url("Themes_/images_/settings_ico.png");
    qproperty-iconSize: 32px 32px;
    qproperty-toolButtonStyle: 0;

    background-color: transparent;
    border: 2px solid #9b4dcc;
    border-radius: 7px;
}
QToolButton#gearButton:hover {
    background-color: #7027a8;
}
QToolButton#gearButton:pressed {
    background-color: #9d4dcc;
}

QPushButton#closeButton {
    qproperty-icon: url("Themes_/images_/close_button_ico.png");
    qproperty-iconSize: 36px 36px;

    background-color: transparent;
    border: 2px solid #9b4dcc;
    border-radius: 7px;
}
QPushButton#closeButton:hover {
    background-color: #7027a8;
}
QPushButton#closeButton:pressed {
    background-color: #9d4dcc;
}

QPushButton#closeButton,
QPushButton#onButton,
QPushButton#offButton {
    background-color: #32104d;
    border: 2px solid #9b4dcc;
    border-radius: 7px;
    color: white;
    font-weight: bold;
}

QPushButton#closeButton:hover,
QPushButton#onButton:hover,
QPushButton#offButton:hover {
    background-color: #7027a8;
}

QTreeWidget#settingsList {
    background-color: #120321;
    border: 2px solid #7027a8;
    border-radius: 7px;
    color: white;
}

QTreeWidget#settingsList::item:selected {
    background-color: #7027a8;
    color: white;
}

QLabel#infoLabel {
    color: #70e7ff;
    background-color: #0f041b;
    font-weight: bold;
}
QFrame#infoPanel {
    background-color: #0a060c;
}

QLineEdit#input_SubLink {
    background-color: #120321;
    border: 2px solid #7027a8;
    border-radius: 7px;
    color: white;
    padding: 6px;
}

QPushButton#button_get_sub {
    background-color: #32104d;
    border: 2px solid #9b4dcc;
    border-radius: 7px;
    color: white;
    padding: 6px;
}



QPushButton#onButton,
QPushButton#offButton {
    background-color: #200933;
    border: 2px solid #C10404;
    border-radius: 7px;
    color: white;
}

QPushButton#onButton:hover,
QPushButton#offButton:hover {
    background-color: #7027a8;
}

QPushButton#onButton:pressed,
QPushButton#offButton:pressed {
    background-color: #9d4dcc;
}


/* SETTING COLORS WHEN BUTTONS HAS STATUS "clicked"*/

                /* PROXY_OFF Released */
QWidget#centralwidget[state="proxy_off"] QFrame#header,
QWidget#centralwidget[state="proxy_off"] QFrame#serverPanel,
QWidget#centralwidget[state="proxy_off"] QLabel#selected_server_label,
QWidget#centralwidget[state="proxy_off"] QLabel#titleLabel,
QWidget#centralwidget[state="proxy_off"] QListWidget#server_list {
    border-color: #C10404;
}
QWidget#centralwidget[state="proxy_off"] QPushButton#offButton {
    border: 2px solid #C10404;
}
                /* PROXY_ON Pressed*/
QWidget#centralwidget[state="proxy_on"] QFrame#header,
QWidget#centralwidget[state="proxy_on"] QFrame#serverPanel,
QWidget#centralwidget[state="proxy_on"] QLabel#selected_server_label,
QWidget#centralwidget[state="proxy_on"] QLabel#titleLabel,
QWidget#centralwidget[state="proxy_on"] QListWidget#server_list {
    border-color: #238B06;
}
QWidget#centralwidget[state="proxy_on"] QPushButton#onButton {
    border: 2px solid #70FF70;
}


                /* TUN_OFF Released */
QWidget#centralwidget[state="TUN_off"] QFrame#header,
QWidget#centralwidget[state="TUN_off"] QFrame#serverPanel,
QWidget#centralwidget[state="TUN_off"] QLabel#selected_server_label,
QWidget#centralwidget[state="TUN_off"] QLabel#titleLabel,
QWidget#centralwidget[state="TUN_off"] QListWidget#server_list {
    border-color: #C10404;
}
QWidget#centralwidget[state="TUN_off"] QPushButton#offButton {
    border: 2px solid #C10404;
}

                /* TUN_ON Pressed */
QWidget#centralwidget[state="TUN_on"] QFrame#header,
QWidget#centralwidget[state="TUN_on"] QFrame#serverPanel,
QWidget#centralwidget[state="TUN_on"] QLabel#selected_server_label,
QWidget#centralwidget[state="TUN_on"] QLabel#titleLabel,
QWidget#centralwidget[state="TUN_on"] QListWidget#server_list {
    border-color: #238B06;
}
QWidget#centralwidget[state="TUN_on"] QPushButton#offButton {
    border: 2px solid #70FF70;
}