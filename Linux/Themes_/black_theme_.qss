QMainWindow,
QDialog,
QWidget#centralwidget {
    background-color: #101010;
    color: #eeeeee;
}

QFrame#header,
QFrame#serverPanel,
QFrame#toggleFrame {
    background-color: #181818;
    border: 2px solid #444444;
    border-radius: 8px;
}

QLabel {
    color: #eeeeee;
}

QLabel#selected_server_label,
QLabel#titleLabel {
    background-color: #202020;
    border: 2px solid #666666;
    border-radius: 6px;
    color: #ffffff;
    font-weight: bold;
}

QListWidget#server_list {
    background-color: #141414;
    border: 2px solid #444444;
    border-radius: 6px;
    color: #eeeeee;
    outline: none;
}

QListWidget#server_list::item {
    padding: 8px;
    border-bottom: 1px solid #303030;
}

QListWidget#server_list::item:selected {
    background-color: #3a3a3a;
    color: white;
}

QToolButton#gearButton,
QPushButton#closeButton,
QPushButton#onButton,
QPushButton#offButton,
QPushButton#button_get_sub {
    background-color: #252525;
    border: 2px solid #555555;
    border-radius: 6px;
    color: #eeeeee;
    padding: 6px;
    font-weight: bold;
}

QToolButton#gearButton:hover,
QPushButton#closeButton:hover,
QPushButton#onButton:hover,
QPushButton#offButton:hover,
QPushButton#button_get_sub:hover {
    background-color: #444444;
}

QTreeWidget#settingsList {
    background-color: #141414;
    border: 2px solid #444444;
    border-radius: 6px;
    color: #eeeeee;
}

QTreeWidget#settingsList::item:selected {
    background-color: #3a3a3a;
    color: white;
}

QLabel#infoLabel {
    background-color: #0a090e;
    color: #70e7ff;
    font-weight: bold;
}

QFrame#infoPanel {
    background-color: #060708;
    border-radius: 8px;
}

QLineEdit#input_SubLink {
    background-color: #141414;
    border: 2px solid #444444;
    border-radius: 6px;
    color: #eeeeee;
    padding: 7px;
}

QToolTip {
    background-color: #202020;
    color: white;
    border: 1px solid #666666;
}


/* SETTING COLORS WHEN BUTTONS HAS STATUS "clicked"
                /* ON */
QWidget#centralwidget[state="proxy_on"] QFrame#header,
QWidget#centralwidget[state="proxy_on"] QFrame#serverPanel,
QWidget#centralwidget[state="proxy_on"] QLabel#selected_server_label,
QWidget#centralwidget[state="proxy_on"] QLabel#titleLabel,
QWidget#centralwidget[state="proxy_on"] QListWidget#server_list {
    border-color: #1f722a;
}                /* OFF */
QWidget#centralwidget[state="off"] QFrame#header,
QWidget#centralwidget[state="off"] QFrame#serverPanel,
QWidget#centralwidget[state="off"] QLabel#selected_server_label,
QWidget#centralwidget[state="off"] QLabel#titleLabel,
QWidget#centralwidget[state="off"] QListWidget#server_list {
    border-color: #600d1b;
}
*/


/* SETTING COLORS WHEN BUTTONS HAS STATUS "clicked"*/

                /* PROXY_OFF Released */
QWidget#centralwidget[PROXY_state="PROXY_OFF"] QFrame#header,
QWidget#centralwidget[PROXY_state="PROXY_OFF"] QFrame#serverPanel,
QWidget#centralwidget[PROXY_state="PROXY_OFF"] QLabel#selected_server_label,
QWidget#centralwidget[PROXY_state="PROXY_OFF"] QLabel#titleLabel,
QWidget#centralwidget[PROXY_state="PROXY_OFF"] QListWidget#server_list {
    border-color: #C10404;
}
QWidget#centralwidget[PROXY_state="PROXY_OFF"] QPushButton#onButton {
    border: 2px solid #C10404;
}
                /* PROXY_ON Pressed*/
QWidget#centralwidget[PROXY_state="PROXY_ON"] QFrame#header,
QWidget#centralwidget[PROXY_state="PROXY_ON"] QFrame#serverPanel,
QWidget#centralwidget[PROXY_state="PROXY_ON"] QLabel#selected_server_label,
QWidget#centralwidget[PROXY_state="PROXY_ON"] QLabel#titleLabel,
QWidget#centralwidget[PROXY_state="PROXY_ON"] QListWidget#server_list {
    border-color: #238B06;
}
QWidget#centralwidget[PROXY_state="PROXY_ON"] QPushButton#onButton {
    border: 2px solid #70FF70;
}


                /* TUN_OFF Released */
QWidget#centralwidget[TUN_state="TUN_OFF"] QFrame#header,
QWidget#centralwidget[TUN_state="TUN_OFF"] QFrame#serverPanel,
QWidget#centralwidget[TUN_state="TUN_OFF"] QLabel#selected_server_label,
QWidget#centralwidget[TUN_state="TUN_OFF"] QLabel#titleLabel,
QWidget#centralwidget[TUN_state="TUN_OFF"] QListWidget#server_list {
    border-color: #C10404;
}
QWidget#centralwidget[TUN_state="TUN_OFF"] QPushButton#offButton {
    border: 2px solid #C10404;
}

                /* TUN_ON Pressed */
QWidget#centralwidget[TUN_state="TUN_ON"] QFrame#header,
QWidget#centralwidget[TUN_state="TUN_ON"] QFrame#serverPanel,
QWidget#centralwidget[TUN_state="TUN_ON"] QLabel#selected_server_label,
QWidget#centralwidget[TUN_state="TUN_ON"] QLabel#titleLabel,
QWidget#centralwidget[TUN_state="TUN_ON"] QListWidget#server_list {
    border-color: #238B06;
}
QWidget#centralwidget[TUN_state="TUN_ON"] QPushButton#offButton {
    border: 2px solid #70FF70;
}